def traveltime():
    start_hour = int(input("Enter departure hour (0-23): "))
    start_minute = int(input("Enter departure minute: "))

    travel_hours = int(input("Enter travel hours: "))
    travel_minutes = int(input("Enter travel minutes: "))

    start_time = start_hour * 60 + start_minute
    total_time = start_time + (travel_hours * 60) + travel_minutes

    arrival_hour = (total_time // 60) % 24
    arrival_minute = total_time % 60

    print(f"Arrival Time: {arrival_hour:02d}:{arrival_minute:02d}")


traveltime()
